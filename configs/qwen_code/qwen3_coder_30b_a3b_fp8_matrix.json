{
  "env": {
    "OPENAI_API_KEY": "not-needed"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "Qwen3-Coder-30B-A3B-Instruct-FP8",
        "name": "Local Qwen3-Coder 30B A3B FP8 matrix",
        "description": "Controlled BeliefKV runtime decision matrix",
        "envKey": "OPENAI_API_KEY",
        "baseUrl": "__OPENAI_BASE_URL__",
        "generationConfig": {
          "timeout": 300000,
          "maxRetries": 0,
          "contextWindowSize": 163840,
          "toolResultContentFormat": "parts",
          "samplingParams": {
            "temperature": 0.0,
            "top_p": 0.8,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "tools": {
    "approvalMode": "yolo",
    "sandbox": "docker",
    "sandboxImage": "ghcr.io/qwenlm/qwen-code:0.19.10",
    "computerUse": {
      "enabled": false
    }
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false
  },
  "agents": {
    "builtin": {
      "exploreModel": "inherit"
    }
  },
  "model": {
    "name": "Qwen3-Coder-30B-A3B-Instruct-FP8",
    "maxSubagentDepth": 3,
    "skipLoopDetection": true,
    "enableOpenAILogging": true,
    "openAILoggingDir": "__OPENAI_LOG_DIR__"
  }
}
